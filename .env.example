# FindLostPuppy 🐾 — Environment Variables Template
# Copy to .env for local development

# Base URL (defaults to / in dev, /findlostpuppy/ in production)
VITE_BASE_URL=/findlostpuppy/

# Future Cloud / Supabase / Firebase backend configuration (optional)
VITE_API_ENDPOINT=https://api.example.com/v1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-placeholder
