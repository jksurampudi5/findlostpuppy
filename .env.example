# FindLostPuppy 🐾 — Environment Variables Template
# Copy to .env for local development

# Base URL (defaults to / in dev, /findlostpuppy/ in production)
VITE_BASE_URL=/findlostpuppy/

# Firebase Spark/free backend configuration
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Cloudinary uploads use signed Firebase Functions and authenticated delivery.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_SECURE_FUNCTIONS=true
VITE_MEDIA_WORKER_URL=https://findlostpuppy-media.your-subdomain.workers.dev

# Never put a Cloudinary API secret in VITE_* variables or frontend code.
# Upload and deletion signatures must be generated by an authenticated backend.
