{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "findlostpuppy-media",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "FIREBASE_PROJECT_ID": "findlostpuppy",
    "ADMIN_EMAIL": "jksurampudi5@gmail.com",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://findlostpuppy.web.app,https://findlostpuppy.firebaseapp.com,capacitor://localhost,http://localhost"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
