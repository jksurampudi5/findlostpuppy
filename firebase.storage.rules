rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'jksurampudi5@gmail.com';
    }

    function isImage() {
      return request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /users/{userId}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId && isImage();
      allow delete: if signedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /profiles/{userId}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId && isImage();
      allow delete: if signedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /pets/{path=**} {
      allow read: if signedIn();
      allow write: if signedIn() && isImage();
      allow delete: if isAdmin();
    }

    match /reports/{path=**} {
      allow read: if true;
      allow write: if signedIn() && isImage();
      allow delete: if isAdmin();
    }

    match /missing-reports/{path=**} {
      allow read: if true;
      allow write: if signedIn() && isImage();
      allow delete: if isAdmin();
    }

    match /sightings/{path=**} {
      allow read: if signedIn();
      allow write: if signedIn() && isImage();
      allow delete: if isAdmin();
    }

    match /suggestions/{suggestionId}/{fileName} {
      allow read: if isAdmin();
      allow write: if signedIn() && isImage();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
